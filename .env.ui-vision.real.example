# Optional env for the heavyweight local upstream model runtimes.
# Bring them up with:
#   docker compose --profile ui-vision-real up -d \
#     omniparser-runtime paddleocr-vl-runtime surya-runtime \
#     groundnext-runtime aria-ui-runtime phi-ground-runtime
#
# These services are the raw local model runtimes. The existing `*-api` sidecars
# are still the stable integration surface for the rest of this repo.
#
# Verified wrapper wiring so far:
# - `omniparser-api` can now use `MODEL_BACKEND=omniparser_runtime`
#   against `http://omniparser-runtime:8000`
# - `paddleocr-vl-api` can now use `MODEL_BACKEND=paddleocr_vl_runtime`
#   against `http://paddleocr-vl-runtime:8080`
# - `surya-api` can now use `MODEL_BACKEND=surya_runtime`
#   against `http://surya-runtime:3000`

HUGGING_FACE_HUB_TOKEN=
UI_VISION_REAL_VISIBLE_GPUS=all

OMNIPARSER_RUNTIME_MODEL_ID=microsoft/OmniParser-v2.0
OMNIPARSER_RUNTIME_DEVICE=cuda
OMNIPARSER_RUNTIME_BOX_THRESHOLD=0.05
OMNIPARSER_RUNTIME_VISIBLE_GPU=0

OMNIPARSER_MODEL_BACKEND=omniparser_runtime
OMNIPARSER_REMOTE_MODEL_URL=http://omniparser-runtime:8000

PADDLEOCR_VL_RUNTIME_IMAGE=ccr-2vdh3abv-pub.cnc.bj.baidubce.com/paddlepaddle/paddleocr-genai-vllm-server:latest-nvidia-gpu
PADDLEOCR_VL_RUNTIME_MODEL_NAME=PaddleOCR-VL-1.5-0.9B
PADDLEOCR_VL_RUNTIME_BACKEND=vllm

PADDLEOCR_VL_MODEL_BACKEND=paddleocr_vl_runtime
PADDLEOCR_VL_REMOTE_MODEL_URL=http://paddleocr-vl-runtime:8080

SURYA_RUNTIME_IMAGE=quay.io/wener/surya-ocr:latest
SURYA_MODEL_BACKEND=surya_runtime
SURYA_REMOTE_MODEL_URL=http://surya-runtime:3000

VLLM_RUNTIME_IMAGE=vllm/vllm-openai:latest
GROUNDNEXT_RUNTIME_MODEL_ID=ServiceNow/GroundNext-7B-V0
GROUNDNEXT_RUNTIME_MAX_MODEL_LEN=8192
GROUNDNEXT_RUNTIME_DTYPE=bfloat16
GROUNDNEXT_RUNTIME_VISIBLE_GPU=1
GROUNDNEXT_MODEL_BACKEND=groundnext_runtime
GROUNDNEXT_REMOTE_MODEL_URL=http://groundnext-runtime:8000

ARIA_UI_RUNTIME_MODEL_ID=Aria-UI/Aria-UI-base
ARIA_UI_RUNTIME_MAX_MODEL_LEN=8192
ARIA_UI_RUNTIME_DTYPE=bfloat16
ARIA_UI_RUNTIME_VISIBLE_GPU=2
ARIA_UI_MODEL_BACKEND=aria_ui_runtime
ARIA_UI_REMOTE_MODEL_URL=http://aria-ui-runtime:8000

PHI_GROUND_RUNTIME_MODEL_ID=microsoft/Phi-Ground
PHI_GROUND_RUNTIME_MAX_MODEL_LEN=8192
PHI_GROUND_RUNTIME_DTYPE=bfloat16
PHI_GROUND_RUNTIME_VISIBLE_GPU=0
PHI_GROUND_MODEL_BACKEND=phi_ground_runtime
PHI_GROUND_REMOTE_MODEL_URL=http://phi-ground-runtime:8000
