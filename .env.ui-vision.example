# Copy selected entries into your shell env or a local .env file before running:
#   docker compose --profile ui-vision up -d
#
# Values default to mock when unset. Set MODEL_BACKEND=http_proxy and provide the
# matching REMOTE_MODEL_URL to route a sidecar through a real external model API.

OMNIPARSER_MODEL_BACKEND=http_proxy
OMNIPARSER_REMOTE_MODEL_URL=http://host.docker.internal:29001

PADDLEOCR_VL_MODEL_BACKEND=http_proxy
PADDLEOCR_VL_REMOTE_MODEL_URL=http://host.docker.internal:29002

SURYA_MODEL_BACKEND=http_proxy
SURYA_REMOTE_MODEL_URL=http://host.docker.internal:29003

GROUNDNEXT_MODEL_BACKEND=http_proxy
GROUNDNEXT_REMOTE_MODEL_URL=http://host.docker.internal:29111

ARIA_UI_MODEL_BACKEND=http_proxy
ARIA_UI_REMOTE_MODEL_URL=http://host.docker.internal:29112

PHI_GROUND_MODEL_BACKEND=http_proxy
PHI_GROUND_REMOTE_MODEL_URL=http://host.docker.internal:29113
